@model IEnumerable<Quiz_Application.Models.DTO.CourseDTO>
@{
    Layout = null;
    var tags = ViewBag.Tags as IEnumerable<string>;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Q-MSTech Dashboard</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --primary-tech: #06b6d4;
            --secondary-tech: #2563eb;
            --dark-surface: #0f172a;
        }

        body { background-color: #f1f5f9; font-family: 'Inter', sans-serif; color: #1e293b; }
        h1, h2, h3, .navbar-brand { font-family: 'Space Grotesk', sans-serif; }

        .navbar { background: var(--dark-surface); padding: 0.8rem 2rem; }
        .navbar-brand { color: white !important; font-weight: 700; display: inline-flex; align-items: center; gap: 0.65rem; }
        .brand-icon { width: 38px; height: 38px; border-radius: 12px; display: inline-flex; align-items: center; justify-content: center; background: linear-gradient(135deg, var(--primary-tech), var(--secondary-tech)); box-shadow: 0 12px 28px rgba(6, 182, 212, 0.28); color: white; }
        .logo-accent { color: var(--primary-tech); }

        .tech-banner {
            background: linear-gradient(135deg, var(--dark-surface) 0%, #1e293b 100%);
            padding: 4rem 0 6rem 0;
            color: white;
            border-bottom: 1px solid rgba(6, 182, 212, 0.2);
        }

        .course-card {
            border: none;
            border-radius: 1rem;
            background: white;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            border: 1px solid #e2e8f0;
        }

        .course-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
            border-color: var(--primary-tech);
        }

        .icon-box {
            width: 48px; height: 48px;
            background: linear-gradient(135deg, var(--primary-tech), var(--secondary-tech));
            border-radius: 12px;
            display: flex; align-items: center; justify-content: center;
            color: white; font-size: 1.25rem; margin-bottom: 1.25rem;
        }

        .btn-generate {
            background: linear-gradient(135deg, var(--primary-tech), var(--secondary-tech));
            color: white;
            font-weight: 700; border-radius: 8px; padding: 0.75rem 1.5rem; border: none;
        }

        .alert-custom { border-left: 5px solid var(--primary-tech); background: white; }

        /* Modal Tech Styling */
        .modal-content { border-radius: 1.5rem; border: none; }
        .form-select-tech { border-radius: 10px; border: 1px solid #e2e8f0; padding: 0.75rem; }
    </style>
</head>
<body>

    <nav class="navbar navbar-expand-lg sticky-top">
        <div class="container">
            <a class="navbar-brand" asp-action="Index">
                <span class="brand-icon"><i class="bi bi-cpu"></i></span>Q-MS<span class="logo-accent">Tech</span>
            </a>
        </div>
    </nav>

    <header class="tech-banner">
        <div class="container text-center">
            <h1 class="display-4 fw-bold mb-3">Course Hub</h1>
            <p class="lead opacity-75 mb-4">Empowering professional growth through AI-driven technical assessments.</p>
            <!-- Button Trigger Modal -->
            <button type="button" class="btn btn-generate shadow" data-bs-toggle="modal" data-bs-target="#initCourseModal">
                <i class="bi bi-plus-lg me-2"></i>Select Course
            </button>
        </div>
    </header>

    <main class="container" style="margin-top: -3rem;">
        
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-custom alert-dismissible fade show shadow-sm mb-4" role="alert">
                <div class="d-flex align-items-center">
                    <i class="bi bi-check-circle-fill fs-4 text-success me-3"></i>
                    <div>@TempData["Success"]</div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }


         @if (TempData["Error"] != null)
         {
            <div class="alert alert-danger border-0 shadow-sm mb-4">
              <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
            </div>
         }

        <div class="row g-4">
            @if (Model == null || !Model.Any())
            {
                <div class="col-12 text-center py-5 bg-white rounded-4 shadow-sm border mt-5">
                    <i class="bi bi-layers opacity-25" style="font-size: 4rem;"></i>
                    <h4 class="mt-3 text-muted">System Ready</h4>
                    <p class="text-secondary">No local course data detected. Please click the button above to generate a course.</p>
                </div>
            }
            else
            {
                @foreach (var course in Model)
                {
                    <div class="col-lg-4 col-md-6">
                        <div class="card course-card h-100 p-4 shadow-sm">
                            <div class="card-body p-0 d-flex flex-column">
                                <div class="icon-box shadow-sm">
                                    <i class="bi bi-terminal"></i>
                                </div>
                                <h5 class="fw-bold text-dark mb-1">@course.CourseName</h5>
                                <p class="text-muted small mb-4">Module ID: @course.Id.ToString().Substring(0, 8)...</p>
                                
                                <div class="d-flex justify-content-between align-items-center mt-auto">
                                    @* Link to the Details action *@
                                    <a asp-action="Details" asp-route-id="@course.Id" class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-semibold">
                                        Open Topics
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </main>

    <!-- Modal for Course Generation -->
    <div class="modal fade" id="initCourseModal" tabindex="-1" aria-labelledby="initCourseModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg">
                <div class="modal-header border-0 pb-0">
                    <h5 class="fw-bold"><i class="bi bi-magic text-info me-2"></i>AI Course Generator</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-action="Generate" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-body py-4">
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-uppercase text-muted">Select Technical Domain</label>
                            <select name="category" class="form-select form-select-tech" required>
                                <option value="" selected disabled>Choose a data stream...</option>
                                @if (tags != null)
                                {
                                    foreach (var tag in tags)
                                    {
                                        <option value="@tag">@tag</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-uppercase text-muted">Complexity Level</label>
                            <select name="difficulty" class="form-select form-select-tech">
                                <option value="Beginner">Level 1: Fundamentals</option>
                                <option value="Intermediate">Level 2: Professional</option>
                                <option value="Expert">Level 3: Architecture</option>
                            </select>
                        </div>
                        <p class="small text-muted mt-3">
                            <i class="bi bi-info-circle me-1"></i> Our AI will generate specialized topics and sub-languages based on this selection.
                        </p>
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn btn-light rounded-3" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-generate px-4">Begin Sync</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <footer class="container py-5 mt-5 text-center text-muted small">
        <p>&copy; @DateTime.Now.Year Q-MSTech Knowledge Systems. All rights reserved.</p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
