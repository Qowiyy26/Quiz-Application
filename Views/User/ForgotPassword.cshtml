@model Quiz_Application.Models.DTO.User.ForgotPasswordRequestModel
@{ Layout = null; }

<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Forgot Password | Q-MSTech</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&family=Space+Grotesk:wght@700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/qmstech-theme.css" />
</head>
<body class="auth-page">
    <button class="theme-toggle" type="button" data-theme-toggle><i class="bi bi-moon-stars"></i></button>
    <main class="auth-shell">
        <section class="auth-card">
            <div class="brand-lockup justify-content-center mb-4">
                <span class="brand-mark"><i class="bi bi-envelope-lock"></i></span>
                <span>Q-MS<span>Tech</span></span>
            </div>
            <h1 class="auth-title">Reset Password</h1>
            <p class="auth-subtitle">Enter your email and we will send a confirmation code.</p>
            @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
            <form asp-action="ForgotPassword" method="post">
                @Html.AntiForgeryToken()
                <label class="qm-label">Email Address</label>
                <input asp-for="Email" type="email" class="form-control qm-input mb-4" placeholder="you@example.com" required />
                <button class="btn qm-primary w-100" type="submit">Send Reset Code</button>
            </form>
            <p class="text-center mt-4 mb-0"><a asp-action="Login" class="qm-link">Back to login</a></p>
        </section>
    </main>
    <script src="~/js/qmstech-theme.js"></script>
</body>
</html>
