@model Quiz_Application.Models.DTO.User.UserDTO
@{
    Layout = null;
    var recentQuizzes = (ViewBag.RecentQuizzes as IEnumerable<Quiz_Application.Models.DTO.QuizDTO>)?.ToList()
        ?? new List<Quiz_Application.Models.DTO.QuizDTO>();
    var averageScore = recentQuizzes.Where(q => q.TotalQuestions > 0)
        .Select(q => (double)q.Score / q.TotalQuestions * 100)
        .DefaultIfEmpty(0)
        .Average();
}

<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard | Q-MSTech</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&family=Space+Grotesk:wght@700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/qmstech-theme.css" />
</head>
<body>
    <div class="dashboard-shell">
        <aside class="dashboard-sidebar">
            <div class="d-flex align-items-center justify-content-between mb-4">
                <a asp-action="Dashboard" asp-controller="User" class="brand-lockup">
                    <span class="brand-mark"><i class="bi bi-cpu"></i></span>
                    <span>Q-MS<span>Tech</span></span>
                </a>
                <button class="theme-toggle position-static" type="button" data-theme-toggle><i class="bi bi-moon-stars"></i></button>
            </div>

            <nav>
                <a asp-action="Dashboard" asp-controller="User" class="nav-link-custom active"><i class="bi bi-grid-fill"></i> Dashboard</a>
                <a asp-action="Index" asp-controller="Course" class="nav-link-custom"><i class="bi bi-journal-code"></i> Course Hub</a>
                <a asp-action="History" asp-controller="Quiz" class="nav-link-custom"><i class="bi bi-clock-history"></i> Quiz History</a>
                <a asp-action="ForgotPassword" asp-controller="User" class="nav-link-custom"><i class="bi bi-shield-lock"></i> Security</a>
                <a asp-action="Logout" asp-controller="User" class="nav-link-custom text-danger"><i class="bi bi-box-arrow-left"></i> Logout</a>
            </nav>
        </aside>

        <main class="dashboard-main">
            <header class="d-flex flex-column flex-lg-row justify-content-between gap-3 mb-4">
                <div>
                    <p class="qm-label mb-2">Learning Dashboard</p>
                    <h1 class="fw-bold mb-1">Welcome, @Model.UserName</h1>
                    <p class="text-secondary mb-0">@Model.Email · Member since @Model.CreatedDate.ToString("MMM yyyy")</p>
                </div>
                <a asp-action="Index" asp-controller="Course" class="btn qm-primary px-4">
                    <i class="bi bi-plus-circle me-2"></i> Start New Quiz
                </a>
            </header>

            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="metric-card h-100">
                        <div class="metric-icon mb-3"><i class="bi bi-ui-checks-grid"></i></div>
                        <p class="text-secondary fw-bold mb-1">Recent Quizzes</p>
                        <h2 class="fw-bold mb-0">@recentQuizzes.Count</h2>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="metric-card h-100">
                        <div class="metric-icon mb-3"><i class="bi bi-graph-up-arrow"></i></div>
                        <p class="text-secondary fw-bold mb-1">Average Score</p>
                        <h2 class="fw-bold mb-0">@averageScore.ToString("F0")%</h2>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="metric-card h-100">
                        <div class="metric-icon mb-3"><i class="bi bi-shield-check"></i></div>
                        <p class="text-secondary fw-bold mb-1">Security</p>
                        <h2 class="fw-bold mb-0">Protected</h2>
                    </div>
                </div>
            </div>

            <section class="qm-card p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <p class="qm-label mb-1">Recent Activity</p>
                        <h2 class="h5 fw-bold mb-0">Latest Quiz Sessions</h2>
                    </div>
                    <a asp-action="History" asp-controller="Quiz" class="qm-link">View all</a>
                </div>

                <div class="table-responsive">
                    <table class="table qm-table align-middle">
                        <thead>
                            <tr>
                                <th>Topic</th>
                                <th>Level</th>
                                <th>Score</th>
                                <th>Date</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (recentQuizzes.Any())
                            {
                                foreach (var quiz in recentQuizzes)
                                {
                                    <tr>
                                        <td class="fw-bold">@quiz.LanguageName</td>
                                        <td><span class="badge rounded-pill text-bg-light border">@quiz.Level</span></td>
                                        <td>@(quiz.TotalQuestions > 0 ? $"{quiz.Score}/{quiz.TotalQuestions}" : "Pending")</td>
                                        <td class="text-secondary">@quiz.CreatedDate.ToString("MMM dd, yyyy")</td>
                                        <td class="text-end">
                                            <a asp-action="Result" asp-controller="Quiz" asp-route-quizId="@quiz.Id" class="btn btn-sm btn-outline-primary rounded-2 fw-bold">View</a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-5 text-secondary">
                                        <i class="bi bi-journal-plus display-6 d-block mb-3"></i>
                                        No quiz activity yet. Start your first quiz from the Course Hub.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        </main>
    </div>
    <script src="~/js/qmstech-theme.js"></script>
</body>
</html>
