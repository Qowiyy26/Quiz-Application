@model Quiz_Application.Models.DTO.User.CreateUserRequestModel
@{ Layout = null; }

<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Create Account | Q-MSTech</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&family=Space+Grotesk:wght@700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/qmstech-theme.css" />
</head>
<body class="auth-page">
    <button class="theme-toggle" type="button" data-theme-toggle><i class="bi bi-moon-stars"></i></button>
    <main class="auth-shell">
        <section class="auth-card">
            <div class="brand-lockup justify-content-center mb-4">
                <span class="brand-mark"><i class="bi bi-person-check"></i></span>
                <span>Q-MS<span>Tech</span></span>
            </div>
            <h1 class="auth-title">Create Account</h1>
            <p class="auth-subtitle">Create a secure account with a strong password.</p>
            @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
            <form asp-action="Register" method="post">
                @Html.AntiForgeryToken()
                <label class="qm-label">Username</label>
                <input asp-for="UserName" class="form-control qm-input mb-3" placeholder="Your name" required />
                <label class="qm-label">Email</label>
                <input asp-for="Email" type="email" class="form-control qm-input mb-3" placeholder="you@example.com" required />
                <label class="qm-label">Password</label>
                <div class="input-group mb-3">
                    <input asp-for="Password" id="registerPassword" type="password" class="form-control qm-input" placeholder="At least 8 chars, upper, lower, number" required />
                    <button class="btn btn-outline-secondary" type="button" data-password-toggle="#registerPassword" aria-label="Show password">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
                <label class="qm-label">Confirm Password</label>
                <div class="input-group mb-4">
                    <input asp-for="ConfirmPassword" id="registerConfirmPassword" type="password" class="form-control qm-input" placeholder="Repeat password" required />
                    <button class="btn btn-outline-secondary" type="button" data-password-toggle="#registerConfirmPassword" aria-label="Show password">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
                <button type="submit" class="btn qm-primary w-100">Create Account</button>
            </form>
            <p class="text-center mt-4 mb-0">Already registered? <a asp-action="Login" class="qm-link">Login</a></p>
        </section>
    </main>
    <script src="~/js/qmstech-theme.js"></script>
    <script>
        document.querySelectorAll('[data-password-toggle]').forEach(button => {
            button.addEventListener('click', () => {
                const input = document.querySelector(button.dataset.passwordToggle);
                const icon = button.querySelector('i');
                const isHidden = input.type === 'password';
                input.type = isHidden ? 'text' : 'password';
                icon.className = isHidden ? 'bi bi-eye-slash' : 'bi bi-eye';
                button.setAttribute('aria-label', isHidden ? 'Hide password' : 'Show password');
            });
        });
    </script>
</body>
</html>
