@using Quiz_Application.Models
@using Quiz_Application.Models.DTO
@using Quiz_Application.Models.Enum
@model Quiz_Application.Models.DTO.QuizSetupViewModel
@{
    Layout = null;
    var languageId = Model.LanguageId;
    var languageName = Model.LanguageName;
}

<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Configure Quiz - Q-MSTech</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/qmstech-theme.css" />

    <style>
        :root {
            --brand: #1d4ed8;
            --brand-soft: #dbeafe;
            --accent: #0f766e;
            --accent-soft: #ccfbf1;
            --ink: #0f172a;
            --muted: #64748b;
            --line: #dbe3ef;
            --surface: #ffffff;
            --page: #f5f7fb;
        }

        body {
            min-height: 100vh;
            background: var(--qm-bg);
            color: var(--qm-text);
            font-family: 'Inter', sans-serif;
        }

        .shell {
            max-width: 980px;
            margin: 0 auto;
            padding: 28px 16px;
        }

        .brand {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            font-family: 'Space Grotesk', sans-serif;
            font-size: 1.45rem;
            font-weight: 700;
            color: var(--qm-text);
        }

        .brand-mark {
            width: 42px;
            height: 42px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 12px;
            background: linear-gradient(135deg, var(--brand), var(--accent));
            color: #fff;
            box-shadow: 0 12px 24px rgba(29, 78, 216, 0.16);
        }

        .panel {
            background: var(--qm-surface);
            border: 1px solid var(--qm-line);
            border-radius: 8px;
            box-shadow: 0 18px 45px rgba(15, 23, 42, 0.07);
        }

        .section-label {
            color: var(--muted);
            font-size: 0.78rem;
            font-weight: 800;
            text-transform: uppercase;
        }

        .level-label {
            min-height: 82px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            gap: 5px;
            border: 1px solid var(--line);
            border-radius: 8px;
            color: var(--qm-text);
            background: var(--qm-surface);
            font-weight: 800;
        }

        .mode-label {
            min-height: 92px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            gap: 6px;
            border: 1px solid var(--line);
            border-radius: 8px;
            color: var(--qm-text);
            background: var(--qm-surface);
            font-weight: 800;
            padding: 0.9rem;
        }

        .mode-label small {
            color: var(--muted);
            font-weight: 650;
        }

        .btn-check:checked + .level-label,
        .btn-check:checked + .mode-label {
            border-color: var(--brand);
            background: var(--brand-soft);
            color: var(--brand);
            box-shadow: 0 0 0 3px rgba(29, 78, 216, 0.12);
        }

        .form-select {
            min-height: 54px;
            border-color: var(--qm-line);
            color: var(--qm-text);
            background: var(--qm-surface);
            border-radius: 8px;
            font-weight: 700;
        }

        .form-select:focus {
            border-color: var(--brand);
            box-shadow: 0 0 0 3px rgba(29, 78, 216, 0.12);
        }

        .subtopic-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 0.75rem;
        }

        .subtopic-option { position: relative; }
        .subtopic-option input { position: absolute; opacity: 0; pointer-events: none; }

        .subtopic-option label {
            min-height: 54px;
            display: flex;
            align-items: center;
            gap: 0.55rem;
            padding: 0.75rem 0.85rem;
            border: 1px solid var(--line);
            border-radius: 8px;
            background: var(--qm-surface);
            color: var(--qm-text);
            cursor: pointer;
            transition: 0.18s ease;
            font-size: 0.92rem;
            font-weight: 650;
            line-height: 1.2;
        }

        .subtopic-option label::before {
            content: "";
            width: 16px;
            height: 16px;
            flex: 0 0 16px;
            border-radius: 5px;
            border: 1px solid #94a3b8;
            background: #fff;
        }

        .subtopic-option input:checked + label {
            border-color: var(--accent);
            background: var(--accent-soft);
            color: #115e59;
        }

        .subtopic-option input:checked + label::before {
            background: var(--accent);
            border-color: var(--accent);
            box-shadow: inset 0 0 0 4px var(--accent-soft);
        }

        .link-tool {
            color: var(--brand);
            border: 0;
            background: transparent;
            padding: 0;
            font-weight: 800;
            font-size: 0.84rem;
        }

        .primary-action {
            min-height: 54px;
            border: 0;
            border-radius: 8px;
            background: linear-gradient(135deg, var(--brand), var(--accent));
            font-weight: 800;
        }

        .helper-text { color: var(--muted); }
    </style>
</head>
<body>
    <main class="shell">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
            <div class="brand">
                <span class="brand-mark"><i class="bi bi-cpu"></i></span>
                <span>Q-MS<span class="text-primary">Tech</span></span>
            </div>
            <a asp-controller="Course" asp-action="Index" class="btn btn-outline-secondary rounded-2 fw-bold">
                <i class="bi bi-arrow-left me-1"></i> Back
            </a>
            <button class="theme-toggle position-static" type="button" data-theme-toggle><i class="bi bi-moon-stars"></i></button>
        </div>

        <section class="panel p-4 p-md-5">
            <div class="mb-4">
                <p class="section-label mb-2">Quiz Configuration</p>
                <h1 class="h3 fw-bold mb-2">@languageName</h1>
                <p class="helper-text mb-0">Questions will be generated from the selected subtopics and difficulty level.</p>
            </div>

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger border-0 shadow-sm mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
                </div>
            }

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success border-0 shadow-sm mb-4" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
                </div>
            }

            <form asp-controller="Quiz" asp-action="Generate" method="post" id="quizForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="languageId" value="@languageId" />

                <div class="mb-4">
                    <label class="section-label mb-3 d-block">Difficulty</label>
                    <div class="row g-3">
                        <div class="col-6 col-md-3">
                            <input type="radio" class="btn-check" name="level" id="lvlEasy" value="Beginner" checked>
                            <label class="level-label text-center" for="lvlEasy">
                                <i class="bi bi-reception-1"></i> Beginner
                            </label>
                        </div>
                        <div class="col-6 col-md-3">
                            <input type="radio" class="btn-check" name="level" id="lvlMed" value="Intermediate">
                            <label class="level-label text-center" for="lvlMed">
                                <i class="bi bi-reception-2"></i> Intermediate
                            </label>
                        </div>
                        <div class="col-6 col-md-3">
                            <input type="radio" class="btn-check" name="level" id="lvlPro" value="Professional">
                            <label class="level-label text-center" for="lvlPro">
                                <i class="bi bi-reception-3"></i> Professional
                            </label>
                        </div>
                        <div class="col-6 col-md-3">
                            <input type="radio" class="btn-check" name="level" id="lvlHard" value="Advanced">
                            <label class="level-label text-center" for="lvlHard">
                                <i class="bi bi-reception-4"></i> Advanced
                            </label>
                        </div>
                    </div>
                </div>

                <div class="mb-4">
                    <label for="questionCount" class="section-label mb-2 d-block">Question Count</label>
                    <select class="form-select form-select-lg" id="questionCount" name="questionCount" required>
                        <option value="20" selected>20 Questions</option>
                        <option value="50">50 Questions</option>
                        <option value="100">100 Questions</option>
                        <option value="150">150 Questions</option>
                    </select>
                </div>

                <div class="mb-4">
                    <label class="section-label mb-3 d-block">Quiz Mode</label>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <input type="radio" class="btn-check" name="quizMode" id="modeStandard" value="Standard" checked>
                            <label class="mode-label" for="modeStandard">
                                <span><i class="bi bi-hourglass-split me-1"></i> Standard Mode</span>
                                <small>One full timer for the whole quiz.</small>
                            </label>
                        </div>
                        <div class="col-md-4">
                            <input type="radio" class="btn-check" name="quizMode" id="modeSpeed" value="Speed">
                            <label class="mode-label" for="modeSpeed">
                                <span><i class="bi bi-lightning-charge me-1"></i> Speed Mode</span>
                                <small>1 minute per question, then auto-next.</small>
                            </label>
                        </div>
                        <div class="col-md-4">
                            <input type="radio" class="btn-check" name="quizMode" id="modeExam" value="Exam">
                            <label class="mode-label" for="modeExam">
                                <span><i class="bi bi-award me-1"></i> Exam Mode</span>
                                <small>Formal result with certificate access.</small>
                            </label>
                        </div>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="section-label mb-3 d-block">Subtopic Track</label>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <input type="radio" class="btn-check" name="subtopicTrack" id="trackFundamentals" value="Fundamentals" checked>
                            <label class="mode-label" for="trackFundamentals">
                                <span><i class="bi bi-book me-1"></i> Fundamentals</span>
                                <small>Beginner subtopics and simple practical tasks.</small>
                            </label>
                        </div>
                        <div class="col-md-4">
                            <input type="radio" class="btn-check" name="subtopicTrack" id="trackProfessional" value="Professional">
                            <label class="mode-label" for="trackProfessional">
                                <span><i class="bi bi-briefcase me-1"></i> Professional</span>
                                <small>Advanced subtopics for project work.</small>
                            </label>
                        </div>
                        <div class="col-md-4">
                            <input type="radio" class="btn-check" name="subtopicTrack" id="trackArchitecture" value="Architecture">
                            <label class="mode-label" for="trackArchitecture">
                                <span><i class="bi bi-diagram-3 me-1"></i> Architecture</span>
                                <small>All subtopics under the selected course.</small>
                            </label>
                        </div>
                    </div>
                </div>

                <div class="mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <label class="section-label m-0">Subtopics</label>
                        <div class="d-flex gap-3">
                            <button type="button" class="link-tool" id="selectAllSubtopics">Select all</button>
                            <button type="button" class="link-tool" id="clearSubtopics">Clear</button>
                        </div>
                    </div>

                    <div class="subtopic-grid">
                        @for (var i = 0; i < Model.Subtopics.Count; i++)
                        {
                            var subtopic = Model.Subtopics[i];
                            var checkboxId = $"subtopic_{i}";
                            var topicTrack = TechSubtopicCatalog.ClassifyTrack(subtopic);
                            <div class="subtopic-option">
                                <input type="checkbox" id="@checkboxId" name="selectedSubtopics" value="@subtopic" checked />
                                <label for="@checkboxId" data-track="@topicTrack">@subtopic</label>
                            </div>
                        }
                    </div>
                </div>

                <button type="submit" class="btn btn-primary btn-lg w-100 primary-action" id="btnGenerate">
                    <span class="spinner-border spinner-border-sm d-none" id="loader"></span>
                    <span id="btnText">Start Quiz</span>
                </button>
            </form>
        </section>
    </main>

    <script>
        document.getElementById('quizForm').addEventListener('submit', function() {
            const btn = document.getElementById('btnGenerate');
            const loader = document.getElementById('loader');
            const btnText = document.getElementById('btnText');

            btn.disabled = true;
            loader.classList.remove('d-none');
            btnText.innerText = " Preparing Questions...";
        });

        const subtopicBoxes = Array.from(document.querySelectorAll('input[name="selectedSubtopics"]'));
        const trackRadios = Array.from(document.querySelectorAll('input[name="subtopicTrack"]'));

        function applySubtopicTrack() {
            const selectedTrack = document.querySelector('input[name="subtopicTrack"]:checked')?.value || 'Architecture';
            subtopicBoxes.forEach(box => {
                const wrapper = box.closest('.subtopic-option');
                const label = wrapper?.querySelector('label');
                const topicTrack = label?.dataset.track || 'Fundamentals';
                const shouldShow = selectedTrack === 'Architecture' || topicTrack === selectedTrack;

                wrapper.classList.toggle('d-none', !shouldShow);
                box.checked = shouldShow;
            });
        }

        trackRadios.forEach(radio => {
            radio.addEventListener('change', applySubtopicTrack);
        });

        document.getElementById('selectAllSubtopics').addEventListener('click', function() {
            subtopicBoxes.forEach(box => {
                if (!box.closest('.subtopic-option')?.classList.contains('d-none')) {
                    box.checked = true;
                }
            });
        });
        document.getElementById('clearSubtopics').addEventListener('click', function() {
            subtopicBoxes.forEach(box => box.checked = false);
        });
        applySubtopicTrack();
    </script>
    <script src="~/js/qmstech-theme.js"></script>
</body>
</html>
