@using Quiz_Application.Models.Enum
@model Quiz_Application.Models.DTO.QuizSetupViewModel
@{
    Layout = null;
    var languageId = Model.LanguageId;
    var languageName = Model.LanguageName;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Configure Neural Assessment - Q-MSTech</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --primary-tech: #06b6d4;
            --secondary-tech: #2563eb;
            --dark-surface: #0f172a;
        }

        body {
            background: radial-gradient(circle at top right, rgba(6, 182, 212, 0.16), transparent 32%), linear-gradient(135deg, #0f172a 0%, #111827 100%);
            font-family: 'Inter', sans-serif;
            color: white;
            min-height: 100vh;
            display: flex;
            align-items: center;
        }

        .card {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(15px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 2rem;
            color: white;
        }

        .form-select, .form-control {
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.2);
            color: white !important;
            border-radius: 0.75rem;
        }

        .form-select:focus {
            background: rgba(255, 255, 255, 0.15);
            border-color: var(--primary-tech);
            box-shadow: none;
        }

        option { background: #1e293b; color: white; }

        .btn-check:checked + .btn-outline-success { background-color: rgba(25, 135, 84, 0.2); color: #4ade80; border-color: #4ade80; }
        .btn-check:checked + .btn-outline-warning { background-color: rgba(255, 193, 7, 0.2); color: #fbbf24; border-color: #fbbf24; }
        .btn-check:checked + .btn-outline-info { background-color: rgba(6, 182, 212, 0.2); color: #67e8f9; border-color: #67e8f9; }
        .btn-check:checked + .btn-outline-danger { background-color: rgba(220, 53, 69, 0.2); color: #f87171; border-color: #f87171; }
        .btn-outline-success, .btn-outline-warning, .btn-outline-info, .btn-outline-danger { border-width: 2px; }

        .logo-accent { color: var(--primary-tech); }
        .brand-logo { display: inline-flex; align-items: center; justify-content: center; gap: 0.75rem; font-family: 'Space Grotesk', sans-serif; color: white; }
        .brand-logo-icon { width: 48px; height: 48px; border-radius: 14px; display: inline-flex; align-items: center; justify-content: center; background: linear-gradient(135deg, var(--primary-tech), var(--secondary-tech)); box-shadow: 0 16px 34px rgba(6, 182, 212, 0.28); color: white; }
        .btn-info { background: linear-gradient(135deg, var(--primary-tech), var(--secondary-tech)); border: 0; color: white; }
        .subtopic-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 0.75rem; }
        .subtopic-option { position: relative; }
        .subtopic-option input { position: absolute; opacity: 0; pointer-events: none; }
        .subtopic-option label {
            min-height: 52px;
            display: flex;
            align-items: center;
            gap: 0.55rem;
            padding: 0.75rem 0.85rem;
            border: 1px solid rgba(255,255,255,0.14);
            border-radius: 0.9rem;
            background: rgba(255,255,255,0.06);
            color: rgba(255,255,255,0.82);
            cursor: pointer;
            transition: 0.2s ease;
            font-size: 0.9rem;
            line-height: 1.2;
        }
        .subtopic-option label::before {
            content: "";
            width: 16px;
            height: 16px;
            flex: 0 0 16px;
            border-radius: 5px;
            border: 1px solid rgba(255,255,255,0.35);
            background: rgba(15,23,42,0.8);
        }
        .subtopic-option input:checked + label {
            border-color: rgba(6,182,212,0.7);
            background: rgba(6,182,212,0.16);
            color: white;
        }
        .subtopic-option input:checked + label::before {
            background: linear-gradient(135deg, var(--primary-tech), var(--secondary-tech));
            border-color: transparent;
            box-shadow: inset 0 0 0 4px rgba(15,23,42,0.85);
        }
        .link-tool { color: #67e8f9; border: 0; background: transparent; padding: 0; font-weight: 700; font-size: 0.82rem; }
    </style>
</head>
<body>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">
            <div class="text-center mb-5">
                <h1 class="brand-logo fw-bold mb-2">
                    <span class="brand-logo-icon"><i class="bi bi-cpu"></i></span>
                    <span>Q-MS<span class="logo-accent">Tech</span></span>
                </h1>
                <p class="text-white-50">Preparing quiz questions for <strong>@languageName</strong></p>
            </div>

            <div class="card shadow-lg">
                <div class="card-body p-4 p-md-5">
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger border-0 shadow-sm mb-4" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
                        </div>
                    }

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success border-0 shadow-sm mb-4" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
                        </div>
                    }

                    <form asp-controller="Quiz" asp-action="Generate" method="post" id="quizForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="languageId" value="@languageId" />

                        <div class="mb-4">
                            <label class="form-label fw-bold mb-3 small text-uppercase opacity-75">Target Complexity Level</label>
                            <div class="row g-3">
                                <div class="col-6 col-md-3">
                                    <input type="radio" class="btn-check" name="level" id="lvlEasy" value="Beginner" checked>
                                    <label class="btn btn-outline-success w-100 py-3" for="lvlEasy">
                                        <i class="bi bi-reception-1 d-block mb-1"></i> Beginner
                                    </label>
                                </div>
                                <div class="col-6 col-md-3">
                                    <input type="radio" class="btn-check" name="level" id="lvlMed" value="Intermediate">
                                    <label class="btn btn-outline-warning w-100 py-3" for="lvlMed">
                                        <i class="bi bi-reception-2 d-block mb-1"></i> Intermed.
                                    </label>
                                </div>
                                <div class="col-6 col-md-3">
                                    <input type="radio" class="btn-check" name="level" id="lvlPro" value="Professional">
                                    <label class="btn btn-outline-info w-100 py-3" for="lvlPro">
                                        <i class="bi bi-reception-3 d-block mb-1"></i> Pro.
                                    </label>
                                </div>
                                <div class="col-6 col-md-3">
                                    <input type="radio" class="btn-check" name="level" id="lvlHard" value="Advanced">
                                    <label class="btn btn-outline-danger w-100 py-3" for="lvlHard">
                                        <i class="bi bi-reception-4 d-block mb-1"></i> Advanced
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label for="questionCount" class="form-label fw-bold small text-uppercase opacity-75">Question Density</label>
                            <select class="form-select form-select-lg" id="questionCount" name="questionCount" required>
                                <option value="20" selected>20 Questions (Minimum)</option>
                                <option value="50">50 Questions (Standard)</option>
                                <option value="100">100 Questions (Extended)</option>
                                <option value="150">150 Questions (Maximum)</option>
                            </select>
                        </div>

                        <div class="mb-4">
                            <label for="durationMinutes" class="form-label fw-bold small text-uppercase opacity-75">Assessment Time Limit</label>
                            <select class="form-select form-select-lg" id="durationMinutes" name="durationMinutes" required>
                                <option value="5">5 Minutes</option>
                                <option value="10">10 Minutes</option>
                                <option value="15">15 Minutes</option>
                                <option value="20" selected>20 Minutes</option>
                                <option value="30">30 Minutes</option>
                                <option value="40">40 Minutes</option>
                                <option value="60">1 Hour</option>
                            </select>
                        </div>

                        <div class="mb-4">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <label class="form-label fw-bold small text-uppercase opacity-75 m-0">Sub Topics Under @languageName</label>
                                <div class="d-flex gap-3">
                                    <button type="button" class="link-tool" id="selectAllSubtopics">Select all</button>
                                    <button type="button" class="link-tool" id="clearSubtopics">Clear</button>
                                </div>
                            </div>

                            <div class="subtopic-grid">
                                @for (var i = 0; i < Model.Subtopics.Count; i++)
                                {
                                    var subtopic = Model.Subtopics[i];
                                    var checkboxId = $"subtopic_{i}";
                                    <div class="subtopic-option">
                                        <input type="checkbox" id="@checkboxId" name="selectedSubtopics" value="@subtopic" checked />
                                        <label for="@checkboxId">@subtopic</label>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="d-grid mt-5">
                            <button type="submit" class="btn btn-info btn-lg rounded-pill fw-bold" id="btnGenerate">
                                <span class="spinner-border spinner-border-sm d-none" id="loader"></span>
                                <span id="btnText">Generate Quiz</span>
                            </button>
                            <a asp-controller="Course" asp-action="Index" class="btn btn-link text-white-50 mt-2 text-decoration-none small">
                                <i class="bi bi-arrow-left me-1"></i> Cancel & Return
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            <div class="text-center mt-4 text-white-50 small">
                <p><i class="bi bi-shield-check me-1"></i> Questions are prepared before the quiz session starts.</p>
            </div>
        </div>
    </div>
</div>

<script>
    document.getElementById('quizForm').addEventListener('submit', function() {
        const btn = document.getElementById('btnGenerate');
        const loader = document.getElementById('loader');
        const btnText = document.getElementById('btnText');

        btn.disabled = true;
        loader.classList.remove('d-none');
        btnText.innerText = " Preparing Questions...";
    });

    const subtopicBoxes = Array.from(document.querySelectorAll('input[name="selectedSubtopics"]'));
    document.getElementById('selectAllSubtopics').addEventListener('click', function() {
        subtopicBoxes.forEach(box => box.checked = true);
    });
    document.getElementById('clearSubtopics').addEventListener('click', function() {
        subtopicBoxes.forEach(box => box.checked = false);
    });
</script>

</body>
</html>
