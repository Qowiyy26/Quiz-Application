@model Quiz_Application.Models.DTO.QuizDTO
@{
    Layout = null;
    var questionTotal = Model?.Questions?.Count ?? 0;
    var durationMinutes = Math.Clamp(Model?.DurationMinutes ?? 7, 5, 60);
    var isSpeedMode = string.Equals(Model?.QuizMode, "Speed", StringComparison.OrdinalIgnoreCase);
    var durationSeconds = isSpeedMode ? 60 : durationMinutes * 60;
    var timerLabel = isSpeedMode ? "1:00" : $"{durationMinutes}:00";
}

<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Q-MSTech | Quiz Session</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/qmstech-theme.css" />

    <style>
        :root {
            --brand: #1d4ed8;
            --brand-soft: #dbeafe;
            --accent: #0f766e;
            --accent-soft: #ccfbf1;
            --ink: #0f172a;
            --muted: #64748b;
            --line: #dbe3ef;
            --surface: #ffffff;
            --page: #f5f7fb;
            --danger: #dc2626;
        }

        [data-theme="dark"] {
            --brand: #60a5fa;
            --brand-soft: rgba(96, 165, 250, 0.16);
            --accent: #2dd4bf;
            --accent-soft: rgba(45, 212, 191, 0.14);
            --ink: #e5edf7;
            --muted: #9aa8bd;
            --line: #273449;
            --surface: #111827;
            --page: #0b1120;
        }

        * { box-sizing: border-box; }

        body {
            min-height: 100vh;
            background: var(--page);
            color: var(--ink);
            font-family: 'Inter', sans-serif;
            padding-bottom: 118px;
        }

        .shell {
            max-width: 980px;
            margin: 0 auto;
            padding: 24px 16px 0;
        }

        .topbar {
            position: sticky;
            top: 0;
            z-index: 30;
            background: color-mix(in srgb, var(--page) 94%, transparent);
            backdrop-filter: blur(14px);
            border-bottom: 1px solid rgba(219, 227, 239, 0.88);
            padding: 14px 0;
        }

        .brand {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            font-family: 'Space Grotesk', sans-serif;
            font-size: 1.35rem;
            font-weight: 700;
            color: var(--ink);
        }

        .brand-mark {
            width: 40px;
            height: 40px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 12px;
            color: white;
            background: linear-gradient(135deg, var(--brand), var(--accent));
            box-shadow: 0 12px 24px rgba(29, 78, 216, 0.18);
        }

        .session-card {
            background: var(--surface);
            border: 1px solid var(--line);
            border-radius: 8px;
            box-shadow: 0 18px 45px rgba(15, 23, 42, 0.07);
            padding: 22px;
            margin: 22px 0;
        }

        .timer-pill {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            min-width: 122px;
            padding: 9px 14px;
            border-radius: 999px;
            background: var(--accent-soft);
            color: #115e59;
            border: 1px solid #99f6e4;
            font-family: 'Space Grotesk', sans-serif;
            font-weight: 700;
        }

        .timer-warning {
            background: #fee2e2;
            border-color: #fecaca;
            color: var(--danger);
            animation: pulse 1s infinite;
        }

        @@keyframes pulse {
            50% { opacity: 0.62; }
        }

        .progress-wrap {
            height: 10px;
            background: var(--brand-soft);
            border-radius: 999px;
            overflow: hidden;
        }

        .progress-bar-inner {
            height: 100%;
            width: 0%;
            background: linear-gradient(90deg, var(--brand), var(--accent));
            transition: width 0.25s ease;
        }

        .quiz-card {
            background: var(--surface);
            border: 1px solid var(--line);
            border-radius: 8px;
            box-shadow: 0 12px 28px rgba(15, 23, 42, 0.05);
            margin-bottom: 18px;
            display: none;
        }

        .quiz-card.active {
            display: block;
        }

        .quiz-card.unanswered-alert {
            border-color: #f59e0b;
            box-shadow: 0 0 0 4px rgba(245, 158, 11, 0.16);
        }

        .question-kicker {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 6px 12px;
            border-radius: 999px;
            background: var(--brand-soft);
            color: var(--brand);
            font-size: 0.78rem;
            font-weight: 800;
            text-transform: uppercase;
        }

        .question-text {
            white-space: pre-wrap;
            line-height: 1.65;
        }

        .question-text.code-question {
            padding: 18px;
            border: 1px solid var(--line);
            border-left: 4px solid var(--accent);
            border-radius: 6px;
            background: color-mix(in srgb, var(--page) 84%, transparent);
            font-family: Consolas, "Courier New", monospace;
            font-size: 0.94rem;
            font-weight: 600;
            line-height: 1.65;
        }

        .option-container {
            display: block;
            min-height: 58px;
            border: 1px solid var(--line);
            border-radius: 8px;
            padding: 15px 16px;
            margin-bottom: 10px;
            background: var(--surface);
            cursor: pointer;
            transition: border-color 0.18s ease, background 0.18s ease, box-shadow 0.18s ease;
        }

        .option-container:hover {
            border-color: rgba(29, 78, 216, 0.55);
            background: var(--brand-soft);
        }

        .option-container:has(.form-check-input:checked) {
            border-color: var(--brand);
            background: var(--brand-soft);
            box-shadow: 0 0 0 3px rgba(29, 78, 216, 0.12);
        }

        .quiz-card.answered .option-container {
            cursor: default;
            pointer-events: none;
        }

        .option-container.option-correct {
            border-color: #16a34a;
            background: #dcfce7;
            box-shadow: 0 0 0 3px rgba(22, 163, 74, 0.14);
        }

        .option-container.option-wrong {
            border-color: #dc2626;
            background: #fee2e2;
            box-shadow: 0 0 0 3px rgba(220, 38, 38, 0.12);
        }

        [data-theme="dark"] .option-container.option-correct {
            background: rgba(22, 163, 74, 0.16);
            border-color: #22c55e;
        }

        [data-theme="dark"] .option-container.option-wrong {
            background: rgba(220, 38, 38, 0.16);
            border-color: #ef4444;
        }

        .answer-feedback {
            display: none;
            border-radius: 8px;
            border: 1px solid var(--line);
            padding: 14px 16px;
            margin-top: 16px;
            background: var(--brand-soft);
        }

        .quiz-card.answered .answer-feedback {
            display: block;
        }

        .answer-feedback.correct {
            background: #dcfce7;
            border-color: #86efac;
            color: #14532d;
        }

        .answer-feedback.wrong {
            background: #fee2e2;
            border-color: #fecaca;
            color: #7f1d1d;
        }

        [data-theme="dark"] .answer-feedback.correct {
            background: rgba(22, 163, 74, 0.16);
            border-color: rgba(34, 197, 94, 0.46);
            color: #bbf7d0;
        }

        [data-theme="dark"] .answer-feedback.wrong {
            background: rgba(220, 38, 38, 0.16);
            border-color: rgba(248, 113, 113, 0.48);
            color: #fecaca;
        }

        .form-check-input {
            width: 1.1rem;
            height: 1.1rem;
            cursor: pointer;
        }

        .form-check-input:checked {
            background-color: var(--brand);
            border-color: var(--brand);
        }

        .option-letter {
            display: inline-flex;
            width: 28px;
            height: 28px;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            background: var(--brand-soft);
            color: var(--ink);
            font-weight: 800;
            flex: 0 0 28px;
        }

        .option-value {
            min-width: 0;
            white-space: pre-wrap;
        }

        .option-value.code-option {
            display: inline-block;
            padding: 7px 9px;
            border: 1px solid var(--line);
            border-radius: 6px;
            background: color-mix(in srgb, var(--page) 82%, transparent);
            font-family: Consolas, "Courier New", monospace;
            font-size: 0.9rem;
            line-height: 1.45;
        }

        .sticky-footer {
            position: fixed;
            left: 0;
            right: 0;
            bottom: 0;
            z-index: 40;
            background: color-mix(in srgb, var(--surface) 96%, transparent);
            backdrop-filter: blur(14px);
            border-top: 1px solid var(--line);
            padding: 16px;
        }

        .submit-btn {
            border: none;
            border-radius: 8px;
            background: linear-gradient(135deg, var(--brand), var(--accent));
            padding: 14px 18px;
            font-weight: 800;
        }

        .nav-btn {
            border-radius: 8px;
            padding: 14px 18px;
            font-weight: 800;
        }

        .helper-text { color: var(--muted); }

        @@media (max-width: 640px) {
            .session-card { padding: 16px; }
            .brand { font-size: 1.08rem; }
            .timer-pill { min-width: 108px; }
        }
    </style>
</head>
<body>
    <div class="topbar">
        <div class="shell py-0">
            <div class="d-flex align-items-center justify-content-between gap-3">
                <div class="brand">
                    <span class="brand-mark"><i class="bi bi-cpu"></i></span>
                    <span>Q-MS<span class="text-primary">Tech</span></span>
                </div>
                <span class="timer-pill" id="timerPill">
                    <i class="bi bi-clock-history"></i>
                    <span id="timerDisplay">@timerLabel</span>
                </span>
                <button class="theme-toggle position-static" type="button" data-theme-toggle title="Toggle dark mode">
                    <i class="bi bi-moon-stars"></i>
                </button>
            </div>
        </div>
    </div>

    <main class="shell">
        <section class="session-card">
            <div class="d-flex flex-column flex-md-row justify-content-between gap-3 mb-3">
                <div>
                    <p class="helper-text mb-1 small text-uppercase fw-bold">Assessment Session</p>
                    <h1 class="h3 fw-bold mb-1">@Model!.LanguageName</h1>
                    <div class="d-flex flex-wrap gap-2 align-items-center">
                        <span class="badge rounded-pill text-bg-light border">Level: @Model!.Level</span>
                        <span class="badge rounded-pill text-bg-light border">@questionTotal Questions</span>
                        <span class="badge rounded-pill text-bg-light border">Mode: @(isSpeedMode ? "Speed - 1 minute each" : "Standard")</span>
                    </div>
                </div>
                <div class="text-md-end">
                    <p class="helper-text mb-1 small fw-semibold">Answered</p>
                    <p class="h4 fw-bold mb-0"><span id="answeredCount">0</span>/<span>@questionTotal</span></p>
                </div>
            </div>
            <div class="progress-wrap">
                <div class="progress-bar-inner" id="answerProgress"></div>
            </div>
        </section>

        <form asp-action="Submit" method="post" id="quizForm" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" name="quizId" value="@Model!.Id" />
            <input type="hidden" name="quizMode" value="@Model!.QuizMode" />
            <input type="hidden" name="timeExpired" id="timeExpired" value="false" />

            @for (int i = 0; i < questionTotal; i++)
            {
                var q = Model!.Questions[i];
                <section class="quiz-card question-card" data-question-id="@q.Id" data-correct-answer="@q.CorrectAnswer">
                    <div class="p-4 p-md-5">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <span class="question-kicker">
                                <i class="bi bi-list-check"></i> Question @(i + 1)
                            </span>
                            <span class="helper-text small">@(i + 1) of @questionTotal</span>
                        </div>

                        @{
                            var isCodeQuestion = !string.IsNullOrWhiteSpace(q.QuestionText) &&
                                (q.QuestionText.Contains("\n") || q.QuestionText.Contains("=>") ||
                                 q.QuestionText.Contains("SELECT ", StringComparison.OrdinalIgnoreCase) ||
                                 q.QuestionText.Contains("await ", StringComparison.OrdinalIgnoreCase));
                        }
                        <h2 class="h5 fw-bold question-text @(isCodeQuestion ? "code-question" : string.Empty) mb-4">@q.QuestionText</h2>

                        @{
                            var options = new[] {
                                new { Val = q.OptionA, Letter = "A" },
                                new { Val = q.OptionB, Letter = "B" },
                                new { Val = q.OptionC, Letter = "C" },
                                new { Val = q.OptionD, Letter = "D" }
                            };
                        }

                        @foreach (var opt in options)
                        {
                            var isCodeOption = !string.IsNullOrWhiteSpace(opt.Val) &&
                                (opt.Val.Contains("=>") || opt.Val.Contains(";") || opt.Val.Contains("(") ||
                                 opt.Val.Contains("{") || opt.Val.StartsWith("await ", StringComparison.OrdinalIgnoreCase) ||
                                 opt.Val.StartsWith("SELECT ", StringComparison.OrdinalIgnoreCase) ||
                                 opt.Val.StartsWith("INSERT ", StringComparison.OrdinalIgnoreCase));
                            <label class="option-container" for="q_@(q.Id)_@opt.Letter" data-option-value="@opt.Val">
                                <span class="d-flex align-items-center gap-3">
                                    <input class="form-check-input shadow-none question-option"
                                           type="radio"
                                           name="answers[@q.Id]"
                                           value="@opt.Val"
                                           id="q_@(q.Id)_@opt.Letter" />
                                    <span class="option-letter">@opt.Letter</span>
                                    <span class="fw-semibold option-value @(isCodeOption ? "code-option" : string.Empty)">@opt.Val</span>
                                    <span class="ms-auto option-status fw-bold small"></span>
                                </span>
                            </label>
                        }

                        <div class="answer-feedback" aria-live="polite">
                            <div class="fw-bold feedback-title mb-1"></div>
                            <div class="small feedback-body"></div>
                        </div>
                    </div>
                </section>
            }

            <div class="sticky-footer">
                <div class="shell py-0">
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-secondary btn-lg nav-btn" id="prevQuestionBtn">
                            <i class="bi bi-chevron-left"></i> Previous
                        </button>
                        <button type="button" class="btn btn-primary btn-lg flex-grow-1 submit-btn shadow-sm" id="nextQuestionBtn">
                            Next <i class="bi bi-chevron-right"></i>
                        </button>
                        <button type="submit" class="btn btn-primary btn-lg flex-grow-1 submit-btn shadow-sm d-none" id="submitQuizBtn">
                            Submit Assessment
                        </button>
                    </div>
                </div>
            </div>
        </form>
    </main>

    <script src="~/js/qmstech-theme.js"></script>
    <script>
        const form = document.getElementById('quizForm');
        const timerDisplay = document.getElementById('timerDisplay');
        const timerPill = document.getElementById('timerPill');
        const timeExpiredInput = document.getElementById('timeExpired');
        const answeredCount = document.getElementById('answeredCount');
        const answerProgress = document.getElementById('answerProgress');
        const questionCards = Array.from(document.querySelectorAll('.question-card'));
        const prevQuestionBtn = document.getElementById('prevQuestionBtn');
        const nextQuestionBtn = document.getElementById('nextQuestionBtn');
        const submitQuizBtn = document.getElementById('submitQuizBtn');
        const questionTotal = questionCards.length;
        const isSpeedMode = @isSpeedMode.ToString().ToLowerInvariant();
        const secondsPerQuestion = 60;
        let remainingSeconds = @durationSeconds;
        let isSubmitting = false;
        let countdownTimer = null;
        let currentQuestionIndex = 0;

        function renderTimer() {
            const minutes = Math.floor(Math.max(remainingSeconds, 0) / 60);
            const seconds = Math.max(remainingSeconds, 0) % 60;
            timerDisplay.textContent = `${minutes}:${seconds.toString().padStart(2, '0')}`;

            const warningAt = isSpeedMode ? 10 : 60;
            if (remainingSeconds <= warningAt) {
                timerPill.classList.add('timer-warning');
            } else {
                timerPill.classList.remove('timer-warning');
            }
        }

        function updateProgress() {
            const answered = questionCards.filter(card => card.dataset.answered === 'true' || card.querySelector('input[type="radio"]:checked')).length;
            answeredCount.textContent = answered;
            answerProgress.style.width = questionTotal === 0 ? '0%' : `${(answered / questionTotal) * 100}%`;
        }

        function firstUnansweredCard() {
            return questionCards.find(card => !card.querySelector('input[type="radio"]:checked'));
        }

        function currentCardAnswered() {
            const card = questionCards[currentQuestionIndex];
            return Boolean(card?.dataset.answered === 'true' || card?.querySelector('input[type="radio"]:checked'));
        }

        function normalizeAnswer(value) {
            return (value || '').trim().replace(/\s+/g, ' ').toLowerCase();
        }

        function revealAnswer(card, selectedValue) {
            if (!card || card.dataset.answered === 'true') {
                return;
            }

            const correctAnswer = card.dataset.correctAnswer || '';
            const selectedAnswer = selectedValue || '';
            const isCorrect = normalizeAnswer(selectedAnswer) === normalizeAnswer(correctAnswer);
            const feedback = card.querySelector('.answer-feedback');
            const feedbackTitle = card.querySelector('.feedback-title');
            const feedbackBody = card.querySelector('.feedback-body');

            card.dataset.answered = 'true';
            card.classList.add('answered');
            feedback?.classList.toggle('correct', isCorrect);
            feedback?.classList.toggle('wrong', !isCorrect);

            card.querySelectorAll('.option-container').forEach(option => {
                const optionValue = option.dataset.optionValue || '';
                const status = option.querySelector('.option-status');
                const optionIsCorrect = normalizeAnswer(optionValue) === normalizeAnswer(correctAnswer);
                const optionIsSelected = normalizeAnswer(optionValue) === normalizeAnswer(selectedAnswer);

                option.classList.toggle('option-correct', optionIsCorrect);
                option.classList.toggle('option-wrong', optionIsSelected && !optionIsCorrect);

                if (status) {
                    status.textContent = optionIsCorrect ? 'Correct' : (optionIsSelected ? 'Your answer' : '');
                }
            });

            if (feedbackTitle) {
                feedbackTitle.innerHTML = isCorrect
                    ? '<i class="bi bi-check-circle-fill me-1"></i> Correct answer'
                    : '<i class="bi bi-x-circle-fill me-1"></i> Wrong answer';
            }

            if (feedbackBody) {
                feedbackBody.textContent = isCorrect
                    ? 'Good choice. Continue to the next practical question.'
                    : `Correct answer: ${correctAnswer}`;
            }
        }

        function showQuestion(index, resetTimer = false) {
            if (!questionCards.length) {
                return;
            }

            currentQuestionIndex = Math.max(0, Math.min(index, questionTotal - 1));
            questionCards.forEach((card, cardIndex) => {
                card.classList.toggle('active', cardIndex === currentQuestionIndex);
            });

            prevQuestionBtn.disabled = isSpeedMode || currentQuestionIndex === 0;
            nextQuestionBtn.classList.toggle('d-none', currentQuestionIndex === questionTotal - 1);
            submitQuizBtn.classList.toggle('d-none', currentQuestionIndex !== questionTotal - 1);

            if (isSpeedMode && resetTimer) {
                remainingSeconds = secondsPerQuestion;
                renderTimer();
            }

            questionCards[currentQuestionIndex].scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        function moveToNextQuestionOrSubmit() {
            if (currentQuestionIndex < questionTotal - 1) {
                questionCards[currentQuestionIndex]?.classList.remove('unanswered-alert');
                showQuestion(currentQuestionIndex + 1, true);
                return;
            }

            submitWhenTimeExpires();
        }

        function submitWhenTimeExpires() {
            if (isSubmitting) {
                return;
            }

            timeExpiredInput.value = 'true';
            form.requestSubmit();
        }

        renderTimer();
        updateProgress();
        showQuestion(0, false);

        countdownTimer = setInterval(() => {
            remainingSeconds -= 1;
            renderTimer();

            if (remainingSeconds <= 0) {
                if (isSpeedMode) {
                    moveToNextQuestionOrSubmit();
                } else {
                    clearInterval(countdownTimer);
                    submitWhenTimeExpires();
                }
            }
        }, 1000);

        document.querySelectorAll('.option-container').forEach(container => {
            container.addEventListener('click', function(event) {
                const card = this.closest('.question-card');
                if (card?.dataset.answered === 'true') {
                    event.preventDefault();
                    return;
                }

                const radio = this.querySelector('input[type="radio"]');
                radio.checked = true;
                card?.classList.remove('unanswered-alert');
                revealAnswer(card, radio.value);
                updateProgress();
            });
        });

        document.querySelectorAll('.question-option').forEach(input => {
            input.addEventListener('change', function() {
                const card = this.closest('.question-card');
                revealAnswer(card, this.value);
                updateProgress();
            });
        });

        prevQuestionBtn.addEventListener('click', () => {
            showQuestion(currentQuestionIndex - 1, false);
        });

        nextQuestionBtn.addEventListener('click', () => {
            const card = questionCards[currentQuestionIndex];
            if (!currentCardAnswered()) {
                card.classList.add('unanswered-alert');
                card.scrollIntoView({ behavior: 'smooth', block: 'center' });
                return;
            }

            showQuestion(currentQuestionIndex + 1, true);
        });

        form.onsubmit = function(event) {
            if (isSubmitting) {
                event.preventDefault();
                return false;
            }

            if (timeExpiredInput.value !== 'true') {
                const missing = firstUnansweredCard();
                if (missing) {
                    event.preventDefault();
                    missing.classList.add('unanswered-alert');
                    showQuestion(questionCards.indexOf(missing));
                    return false;
                }
            }

            isSubmitting = true;
            clearInterval(countdownTimer);

            const btn = submitQuizBtn;
            btn.disabled = true;
            btn.innerHTML = timeExpiredInput.value === 'true'
                ? '<span class="spinner-border spinner-border-sm me-2"></span>Time Up - Submitting...'
                : '<span class="spinner-border spinner-border-sm me-2"></span>Submitting Assessment...';
        };
    </script>
</body>
</html>
