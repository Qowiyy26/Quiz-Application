@{
    Layout = null;
    var score = TempData["Score"];
    var total = TempData["TotalQuestions"];
    var quizId = ViewBag.QuizId;
    var resultId = ViewBag.ResultId;
    var quizMode = (ViewBag.QuizMode as string) ?? "";
    var isExamMode = string.Equals(quizMode, "Exam", StringComparison.OrdinalIgnoreCase);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Diagnostics Result - Q-MSTech</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&family=Space+Grotesk:wght@600;700&display=swap" rel="stylesheet">
    <style>
        :root { --mst-cyan: #06b6d4; --mst-blue: #2563eb; --mst-dark: #0f172a; }
        body { background: #f1f5f9; font-family: 'Inter', sans-serif; display: flex; align-items: center; min-height: 100vh; }
        .result-card { border: none; border-radius: 2.5rem; overflow: hidden; background: white; box-shadow: 0 20px 40px rgba(0,0,0,0.05); }
        .brand-heading { font-family: 'Space Grotesk', sans-serif; color: var(--mst-dark); }
        .score-circle { width: 180px; height: 180px; border-radius: 50%; border: 10px solid var(--mst-cyan); display: flex; flex-direction: column; align-items: center; justify-content: center; margin: 0 auto 2rem; box-shadow: 0 16px 34px rgba(6, 182, 212, 0.18); }
        .ai-feedback { background: var(--mst-dark); color: #cffafe; border-radius: 1.5rem; padding: 2rem; position: relative; }
        .ai-feedback::after { content: "\f62d"; font-family: "bootstrap-icons"; position: absolute; top: -15px; left: 30px; background: linear-gradient(135deg, var(--mst-cyan), var(--mst-blue)); color: white; padding: 5px 15px; border-radius: 50px; font-weight: bold; }
        .btn-info { background: linear-gradient(135deg, var(--mst-cyan), var(--mst-blue)); border: 0; color: white; }
    </style>
</head>
<body>
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-7 text-center">
                <div class="result-card p-5">
                    <h1 class="h4 fw-bold opacity-75 mb-4 brand-heading">Q-MSTech Result Report</h1>
                    
                    <div class="score-circle">
                        <span class="display-3 fw-bold">@score</span>
                        <span class="text-muted fw-bold">OF @total</span>
                    </div>

                    <h2 class="fw-bold mb-4">Assessment Complete</h2>
                    
                    <div class="ai-feedback text-start mb-5 shadow-lg">
                        <p class="mb-0 italic lead">"@ViewBag.ResultText"</p>
                    </div>

                    <div class="d-grid gap-3">
                        @if (isExamMode)
                        {
                            <a asp-action="Certificate" asp-route-quizId="@quizId" asp-route-resultId="@resultId" class="btn btn-success py-3 rounded-pill fw-bold">
                                <i class="bi bi-award-fill me-2"></i>View Certificate
                            </a>
                        }
                        <a asp-action="Review" asp-route-quizId="@quizId" class="btn btn-warning py-3 rounded-pill fw-bold">
                            Review Correct & Wrong Answers
                        </a>
                        <a asp-action="Suggestions" asp-route-quizResultId="@resultId" class="btn btn-info py-3 rounded-pill fw-bold">
                            Generate AI Study Plan
                        </a>
                        <div class="d-flex gap-2">
                            <a asp-action="History" class="btn btn-dark w-100 py-3 rounded-pill">View Logs</a>
                            <a asp-controller="Course" asp-action="Index" class="btn btn-outline-dark w-100 py-3 rounded-pill">Dashboard</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
